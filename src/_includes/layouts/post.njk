---
layout: layouts/base.njk
pageType: post
---
      <article class="posts-article">
        <a class="posts-back" href="/posts/">← Journal</a>
        <div class="posts-article-inner">
          <div class="posts-article-meta">
            <span>Frank Yin</span>
            <span>@qervas</span>
            <time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
            {% if tags %}
            <span class="posts-card-tags">
              {% for tag in tags %}
                {% if tag != "journal" %}
                <span class="posts-tag">{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </span>
            {% endif %}
          </div>
          <h2 class="posts-article-title">{{ title }}</h2>
          {% if description %}
          <p class="posts-article-dek">{{ description }}</p>
          {% endif %}
{% include "chrome/post-share.njk" %}
{% if video %}
          <figure class="posts-video">
            <video controls preload="metadata" playsinline poster="{{ video.poster }}" width="1920" height="1080">
              <source src="{{ video.src }}" type="video/mp4">
              {% if video.vtt %}<track kind="captions" src="{{ video.vtt }}" srclang="en" label="English">{% endif %}
              Your browser does not support HTML video. <a href="{{ video.src }}">Download the video</a>.
            </video>
            {% if video.caption %}<figcaption>{{ video.caption }}</figcaption>{% endif %}
          </figure>
{% endif %}
          <div class="posts-article-body">
{{ content | safe }}
          </div>
          <div class="posts-article-foot">
            <a href="/posts/">All journal entries</a>
            <a href="/">← Work</a>
          </div>
        </div>
      </article>

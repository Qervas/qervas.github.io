{% set isJournal = pageType == "journal" or pageType == "post" %}
{% set journalPosts = collections.journal if collections.journal else [] %}
    <aside class="rail-left" aria-label="On this page">
      <div class="aside-card rail-index">
{% if isJournal and journalPosts.length %}
        <div class="aside-card-title">Journal</div>
        <nav class="rail-toc">
          {% for post in journalPosts %}
          <a class="rail-toc-link{% if page.url == post.url %} is-active{% endif %}" href="{{ post.url }}">{{ post.data.title }}</a>
          {% endfor %}
          <a class="rail-toc-link" href="/">Work</a>
        </nav>
{% else %}
        <div class="aside-card-title">Work</div>
        <nav class="rail-toc">
          <a class="rail-toc-link" href="/#post-ohao" data-nav="post-ohao">Ohao Engine</a>
          <a class="rail-toc-link" href="/#post-thesis" data-nav="post-thesis">Neural rendering dataset</a>
          <a class="rail-toc-link" href="/#projects" data-nav="projects">Projects</a>
          <a class="rail-toc-link" href="/#experience" data-nav="experience">Experience</a>
          <a class="rail-toc-link" href="/#skills" data-nav="skills">Skills</a>
          <a class="rail-toc-link" href="/#education" data-nav="education">Education</a>
        </nav>
{% endif %}
      </div>
      <div class="rail-contact">
        <button type="button" class="rail-cta" id="rail-contact-btn" aria-expanded="false" aria-controls="rail-contact-menu">
          Contact me
        </button>
        <div class="rail-contact-menu" id="rail-contact-menu" hidden>
          <a class="rail-contact-item" href="mailto:frankyin17@outlook.com">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <span>Email</span>
          </a>
          <a class="rail-contact-item" href="https://x.com/FrankYin17" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
            <span>X · @FrankYin17</span>
          </a>
        </div>
      </div>
    </aside>

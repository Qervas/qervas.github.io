{% set shareUrl = site.url ~ page.url %}
          <div class="posts-share" data-share-url="{{ shareUrl }}" data-share-title="{{ title }}">
            <details class="posts-share-details">
              <summary class="posts-share-toggle" aria-label="Share this journal post">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/></svg>
                Share
              </summary>
              <div class="posts-share-menu" role="menu">
                <a
                  class="posts-share-item"
                  role="menuitem"
                  href="https://twitter.com/intent/tweet?url={{ shareUrl | urlencode }}&amp;text={{ title | urlencode }}"
                  target="_blank"
                  rel="noopener"
                >Share on X</a>
                <a
                  class="posts-share-item"
                  role="menuitem"
                  href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}"
                  target="_blank"
                  rel="noopener"
                >Share on LinkedIn</a>
                <button type="button" class="posts-share-item posts-share-copy" role="menuitem" data-share-copy>
                  Copy link
                </button>
              </div>
            </details>
          </div>

{% set heroPost = null %}
{% for p in collections.journal %}{% if not heroPost and p.data.video %}{% set heroPost = p %}{% endif %}{% endfor %}
{% if heroPost %}
      <section class="home-journal-compact" aria-label="From the notes" id="home-journal-teaser">
        <div class="home-journal-compact-copy">
          <p class="home-journal-compact-kicker">Notes</p>
          <h2 class="home-journal-compact-title"><a href="{{ heroPost.url }}">{{ heroPost.data.title | cleanTitle }}</a></h2>
          <p class="home-journal-compact-hook">{{ heroPost.data.hook or (heroPost.data.description | hook) }}</p>
          <a class="home-journal-compact-all" href="/posts/">All notes →</a>
        </div>
      </section>
{% endif %}

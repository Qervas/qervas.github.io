{% set heroPost = null %}
{% for p in collections.journal %}{% if not heroPost and p.data.video %}{% set heroPost = p %}{% endif %}{% endfor %}
{% if heroPost %}
      <section class="home-hero" aria-label="Latest explainer video" id="home-journal-teaser">
        <div class="home-hero-player">
          <video controls preload="none" playsinline poster="{{ heroPost.data.video.poster }}" width="1920" height="1080">
            <source src="{{ heroPost.data.video.src }}" type="video/mp4">
            {% if heroPost.data.video.vtt %}<track kind="captions" src="{{ heroPost.data.video.vtt }}" srclang="en" label="English">{% endif %}
          </video>
        </div>
        <div class="home-hero-copy">
          <p class="home-hero-kicker">New explainer · {{ heroPost.data.video.src | videoDuration }}</p>
          <h2 class="home-hero-title"><a href="{{ heroPost.url }}">{{ heroPost.data.title | cleanTitle }}</a></h2>
          <p class="home-hero-dek">{{ heroPost.data.hook or (heroPost.data.description | hook) }}</p>
          <a class="home-hero-cta" href="/posts/">Browse all videos →</a>
        </div>
      </section>
{% endif %}

{# expects `p` (a journal collection item) and optional `cardClass` #}
{% set dur = p.data.video.src | videoDuration if p.data.video else null %}
<a class="vcard {{ cardClass }}" href="{{ p.url }}">
  <span class="vcard-thumb">
    <img src="{{ p.data.video.poster if p.data.video else p.data.cover }}" alt="" loading="lazy" decoding="async" width="640" height="360" />
    {% if p.data.video %}
    <span class="vcard-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
    {% if dur %}<span class="vcard-badge">{{ dur }}</span>{% endif %}
    {% else %}
    <span class="vcard-badge vcard-badge-soon">Video coming</span>
    {% endif %}
  </span>
  <span class="vcard-body">
    <span class="vcard-title">{{ p.data.title | cleanTitle }}</span>
    <span class="vcard-hook">{{ p.data.description | hook }}</span>
    <time class="vcard-date" datetime="{{ p.date | dateISO }}">{{ p.date | dateDisplay }}</time>
  </span>
</a>

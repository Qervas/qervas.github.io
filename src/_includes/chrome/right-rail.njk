    <aside class="rail-right" aria-label="Sidebar">
      <div class="aside-card aside-journal-card">
        <div class="aside-card-head">
          <div class="aside-card-title">Journal</div>
          <a class="aside-journal-all" href="/posts/">All →</a>
        </div>
        {% if collections.journal and collections.journal.length %}
        <div class="aside-journal-list">
          {% for post in collections.journal %}
          <a class="aside-journal-item" href="{{ post.url }}">
            {% if post.data.cover %}
            <img class="aside-journal-thumb" src="{{ post.data.cover }}" alt="" loading="lazy" decoding="async" />
            {% endif %}
            <div class="aside-journal-copy">
              <time class="aside-journal-date" datetime="{{ post.date | dateISO }}">{{ post.date | dateDisplay }}</time>
              <div class="aside-journal-title">{{ post.data.title }}</div>
              {% if post.data.description %}
              <p class="aside-journal-dek">{{ post.data.description }}</p>
              {% endif %}
              {% if post.data.tags %}
              <div class="aside-journal-tags">
                {% for tag in post.data.tags %}
                  {% if tag != "journal" %}
                  <span class="posts-tag">{{ tag }}</span>
                  {% endif %}
                {% endfor %}
              </div>
              {% endif %}
            </div>
          </a>
          {% endfor %}
        </div>
        {% else %}
        <p class="aside-journal-empty">No entries yet.</p>
        {% endif %}
      </div>

      <div class="aside-card aside-heatmap" id="aside-heatmap">
        <div class="aside-card-head">
          <div class="aside-card-title">GitHub</div>
          <a class="aside-heatmap-handle" href="https://github.com/Qervas" target="_blank" rel="noopener">@Qervas</a>
        </div>
        <div class="gh-stats" aria-label="Contribution stats">
          <div class="gh-stat">
            <span class="gh-stat-n" id="gh-heatmap-num">—</span>
            <span class="gh-stat-l">contribs</span>
          </div>
          <div class="gh-stat">
            <span class="gh-stat-n" id="gh-streak">—</span>
            <span class="gh-stat-l">streak</span>
          </div>
          <div class="gh-stat">
            <span class="gh-stat-n" id="gh-peak">—</span>
            <span class="gh-stat-l">peak</span>
          </div>
        </div>
        <p class="gh-year-line"><span id="gh-heatmap-year">2026</span> · public activity</p>
        <div class="gh-heat-wrap">
          <div class="gh-heat-scroll" id="gh-heat-scroll">
            <div class="gh-heat-track" id="gh-heat-track">
              <div class="gh-heat-months" id="gh-heat-months" aria-hidden="true"></div>
              <div class="gh-heat-body">
                <div class="gh-heat-days" aria-hidden="true">
                  <span>Mon</span><span>Wed</span><span>Fri</span>
                </div>
                <div
                  class="gh-heat is-loading"
                  id="gh-heat"
                  role="img"
                  aria-label="GitHub contribution heatmap for @Qervas"
                ></div>
              </div>
            </div>
          </div>
          <div class="gh-heat-legend">
            <span class="gh-heat-legend-label">Less</span>
            <span class="gh-cell l0" title="0"></span>
            <span class="gh-cell l1" title="low"></span>
            <span class="gh-cell l2" title="mid"></span>
            <span class="gh-cell l3" title="high"></span>
            <span class="gh-cell l4" title="peak"></span>
            <span class="gh-heat-legend-label">More</span>
          </div>
        </div>
        <a class="aside-heatmap-caption" href="https://github.com/Qervas" target="_blank" rel="noopener">
          View profile on GitHub ↗
        </a>
        <div class="gh-tooltip" id="gh-tooltip" hidden></div>
      </div>

      <div class="aside-footer">
        <a href="mailto:frankyin17@outlook.com">Email</a> ·
        <a href="https://x.com/FrankYin17" target="_blank" rel="noopener">X</a> ·
        <a href="/posts/">Journal</a> ·
        <a href="/ohao-engine/">Ohao booth</a><br />
        © Frank Yin
      </div>
    </aside>
